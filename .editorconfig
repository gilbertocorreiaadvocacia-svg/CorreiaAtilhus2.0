# Recuo e fim de linha iguais em qualquer editor.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# O Windows so executa .bat e .cmd com CRLF.
[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
