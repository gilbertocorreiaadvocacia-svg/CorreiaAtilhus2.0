# MODELO. Copie como  .env  (nesta pasta, hospedagem/) e preencha tudo.
# O .env fica FORA do repositorio (veja o .gitignore).

# --- Endereco ---------------------------------------------------------------
# O DNS deste dominio precisa apontar (registro A) para o IP da VPS ANTES de
# subir: sem isso o Caddy nao consegue o certificado HTTPS.
DOMINIO=atendimento.seudominio.com.br
# E-mail que o Let's Encrypt usa para avisar sobre o certificado.
EMAIL_HTTPS=voce@seudominio.com.br

# --- Administrador ----------------------------------------------------------
# Na primeira subida, e ao trazer os dados do notebook se o administrador
# ainda tiver a senha padrao, esta passa a ser a senha dele.
# Minimo 12 caracteres. Depois de trocada pela tela, o .env nao a desfaz.
CORREIA_ADMIN_EMAIL=admin@correia.adv.br
CORREIA_ADMIN_SENHA=

# --- Evolution (WhatsApp por QR Code) ---------------------------------------
# Gere cada um na VPS com:   openssl rand -hex 20
AUTHENTICATION_API_KEY=
POSTGRES_SENHA=

# --- Opcional: espelho no Supabase ------------------------------------------
CORREIA_SUPABASE_URL=
CORREIA_SUPABASE_CHAVE=
